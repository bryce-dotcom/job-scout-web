{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/drain-migrations",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/stripe-sync-books",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/resync-bonuses",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/expire-trials",
      "schedule": "23 8 * * *"
    },
    {
      "path": "/api/cron/plaid-sync",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron/categorize-transactions",
      "schedule": "50 */6 * * *"
    },
    {
      "path": "/api/cron/watchdog-sync",
      "schedule": "7,22,37,52 * * * *"
    },
    {
      "path": "/api/cron/feedback-sweep",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/estimate-followup",
      "schedule": "10 16 * * *"
    }
  ],
  "functions": {
    "api/cron/drain-migrations.js": {
      "maxDuration": 300
    },
    "api/cron/stripe-sync-books.js": {
      "maxDuration": 300
    },
    "api/cron/resync-bonuses.js": {
      "maxDuration": 300
    },
    "api/cron/expire-trials.js": {
      "maxDuration": 60
    },
    "api/cron/plaid-sync.js": {
      "maxDuration": 300
    },
    "api/cron/estimate-followup.js": {
      "maxDuration": 300
    }
  }
}
